#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

required=(
  AGENTS.md
  README.md
  opencode.jsonc
  upstream-lock.json
  .opencode/agents/factory.md
  .opencode/agents/worker.md
  .opencode/agents/reviewer.md
  .opencode/skills/factory-intake/SKILL.md
  .opencode/skills/factory-plan/SKILL.md
  .opencode/skills/factory-dispatch/SKILL.md
  .opencode/skills/factory-status/SKILL.md
  scripts/factory-start-worker
  docs/agents/issue-tracker.md
  docs/factory/workflow.md
)

for path in "${required[@]}"; do
  [[ -f $path ]] || { echo "error: missing $path" >&2; exit 1; }
done

python - <<'PY'
import fnmatch
import json
import re
from pathlib import Path

config = json.loads(Path("opencode.jsonc").read_text())
lock = json.loads(Path("upstream-lock.json").read_text())
assert lock["schemaVersion"] == 1
assert len(lock["sources"]) == 2

def agent_permissions(path):
    frontmatter = Path(path).read_text().split("---", 2)[1]
    rules = []
    for block in re.split(r"\n  - action: ", frontmatter)[1:]:
        action = block.splitlines()[0].strip()
        resource = re.search(r'\n    resource: "([^"]+)"', block)
        effect = re.search(r"\n    effect: (\w+)", block)
        if resource and effect:
            rules.append({"action": action, "resource": resource.group(1), "effect": effect.group(1)})
    return rules

def effective_merge_permission(agent):
    command = "gh pr merge 123"
    rules = config["permissions"] + agent_permissions(f".opencode/agents/{agent}.md")
    matches = [rule for rule in rules if fnmatch.fnmatchcase("shell", rule["action"])
               and fnmatch.fnmatchcase(command, rule["resource"])]
    assert matches, f"no merge permission rule for {agent}"
    return matches[-1]["effect"]

global_merge_rules = [rule for rule in config["permissions"]
                      if fnmatch.fnmatchcase("shell", rule["action"])
                      and fnmatch.fnmatchcase("gh pr merge 123", rule["resource"])]
assert global_merge_rules and global_merge_rules[-1]["effect"] == "deny"
assert effective_merge_permission("factory") == "allow"
assert effective_merge_permission("worker") == "deny"
assert effective_merge_permission("reviewer") == "deny"

factory_rules = config["permissions"] + agent_permissions(".opencode/agents/factory.md")
admin_matches = [rule for rule in factory_rules
                 if fnmatch.fnmatchcase("shell", rule["action"])
                 and fnmatch.fnmatchcase("gh pr merge 123 --admin", rule["resource"])]
assert admin_matches and admin_matches[-1]["effect"] == "deny"
PY

aggregate_hash() {
  LC_ALL=C find . -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1
}

expected_matt=$(python -c 'import json; print(json.load(open("upstream-lock.json"))["sources"][0]["aggregateSha256"])')
actual_matt=$(cd vendor/matt-pocock-skills && aggregate_hash)
[[ $actual_matt == "$expected_matt" ]] || { echo "error: Matt Pocock vendor hash differs from upstream-lock.json" >&2; exit 1; }

expected_ponytail=$(python -c 'import json; print(json.load(open("upstream-lock.json"))["sources"][1]["aggregateSha256"])')
actual_ponytail=$(cd vendor/ponytail && aggregate_hash)
[[ $actual_ponytail == "$expected_ponytail" ]] || { echo "error: Ponytail vendor hash differs from upstream-lock.json" >&2; exit 1; }

grep -q '^model: openai/gpt-5.6-luna#high$' .opencode/agents/factory.md
grep -q '^model: openai/gpt-5.6-luna#high$' .opencode/agents/worker.md
grep -q '^model: openai/gpt-5.6-luna#high$' .opencode/agents/reviewer.md
git diff --check
shellcheck scripts/factory-setup scripts/factory-start-worker scripts/factory-status scripts/validate-template

echo "Template validation passed."
python3 scripts/test-handoff.py
